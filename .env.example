# Endereço público da plataforma, sem barra no fim
PUBLIC_URL=https://wedding4ever.pt

# Ligação de administração ao PostgreSQL.
# Este utilizador precisa de poder criar bases de dados e utilizadores.
DATABASE_URL=postgres://w4e_admin:muda-esta-palavra-passe@postgres:5432/wedding4ever

# Gera com: openssl rand -hex 32
# Deriva as palavras-passe das bases dos clientes. Não pode ser alterado depois.
APP_SECRET=

# Primeiro administrador, criado apenas se ainda não existir nenhum
ADMIN_EMAIL=tu@exemplo.pt
ADMIN_PASSWORD=

# Pasta onde ficarão as fotografias
STORAGE_DIR=/data
PORT=3000
